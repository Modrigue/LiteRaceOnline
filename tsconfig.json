{
    "compilerOptions": {
        "outDir": "js",
        "rootDir": "ts",
        "target": "ES2016",
        "lib": ["ES2016", "DOM"],
        "module": "commonjs",       /* supports modules */
        "types": ["node", "bcryptjs"],
        "esModuleInterop": true,    /* former exports retrocompatibilty */
        "skipLibCheck": true,       /* skip type-check inside node_modules/@types */
        "noEmitOnError": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitThis": false,
        "sourceMap": true,          /* for ts debug */
        "pretty": true
    },
    "exclude": ["node-modules"],
    "include": [
        "ts/**/*.ts"
    ],
}

/* npm run dev */